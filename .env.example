# Photon dashboard (app.photon.codes) -> your project -> Settings
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# aistudio.google.com -> Get API key (free). Leave blank to run the offline stub brain.
GEMINI_API_KEY=
# The fast model goes first: "instantly" is the promise. The fallbacks only run if it is busy.
GEMINI_MODEL=gemini-3.5-flash-lite
# Where the map lives. The agent only texts this link when it is a real public URL.
MAP_URL=http://localhost:1290
# The name on the map and in the page title.
APP_NAME=Bearing

# /admin is off until this is set (8+ characters). The value lives in brain/credentials.md, never here.
ADMIN_PASSCODE=

# Claude writes the words (scores, replies, deck copy); Gemini keeps photos + embeddings and is the fallback.
# Key lives in /etc/slopstop/env on the server. CLAUDE_MODEL picks the model (default claude-opus-5-5).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
